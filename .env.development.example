# Ben Digital Solution - local development template
# Copy to .env.development, or merge into .env. Never commit real credentials.
# REDIS_URL is intentionally absent: local development uses LocMemCache.

DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=insecure-development-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SITE_NAME=Ben Digital Solution
SITE_URL=http://localhost:3000

# SQLite fallback for local development.
# Use an absolute Windows path with forward slashes.
DATABASE_URL=sqlite:///C:/path/to/project/backend/db.sqlite3

# REDIS_URL is intentionally unset.
# Set it only when Redis 8.4.8 is available, e.g. through Docker Compose:
# REDIS_URL=redis://127.0.0.1:6379/0

DB_CONNECT_TIMEOUT=5
POSTGRES_DB=bds
POSTGRES_USER=bds
POSTGRES_PASSWORD=change-me-db-password

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_RECIPIENT_EMAIL=admin@example.com
EMAIL_TIMEOUT=10

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1
NEXT_TELEMETRY_DISABLED=1

REVALIDATE_SECRET=change-me-local-revalidation-secret
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate

MEDIA_ROOT=C:/path/to/project/backend/media
MEDIA_URL=/media/

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO

THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=20/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_EMAIL=3/hour
THROTTLE_CONTACT=3/hour
THROTTLE_SEARCH=60/min
THROTTLE_SEARCH_USER=120/min
THROTTLE_SEARCH_SUGGEST=30/min
THROTTLE_SEARCH_SUGGEST_USER=60/min
