# Ben Digital Solution - shared environment variable template
# Use the environment-specific templates when possible:
#   .env.development.example -> .env.development
#   .env.test.example        -> .env.test
#   .env.production.example  -> .env.production
# Copy to .env for a shared fallback. Never commit .env or real credentials.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-use-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
SITE_NAME=Ben Digital Solution
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://bds:change-me-db-password@db:5432/bds
DB_CONNECT_TIMEOUT=5
POSTGRES_DB=bds
POSTGRES_USER=bds
POSTGRES_PASSWORD=change-me-db-password

# ---------------------------------------------------------------------------
# Redis (cache, sessions, throttles)
# ---------------------------------------------------------------------------
#REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Cookies and transport security
# Set all three to True in production.
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# ---------------------------------------------------------------------------
# Email (transactional only)
# Development default prints email to the console.
# Production uses the SMTP/API provider configured by the operator.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_RECIPIENT_EMAIL=admin@example.com
EMAIL_TIMEOUT=10
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=86400

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# Browser requests use the same-origin /api/v1 path.
# Server Components use the internal container URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://backend:8000/api/v1
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Content revalidation (Django -> Next.js webhook)
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=change-me-revalidation-secret
REVALIDATE_URL=http://frontend:3000/api/revalidate

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# ---------------------------------------------------------------------------
# Observability
# Leave SENTRY_DSN empty to disable error tracking.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Throttle defaults (DRF scope rates)
# ---------------------------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=20/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_EMAIL=3/hour
THROTTLE_CONTACT=3/hour
THROTTLE_SEARCH=60/min
THROTTLE_SEARCH_USER=120/min
THROTTLE_SEARCH_SUGGEST=30/min
THROTTLE_SEARCH_SUGGEST_USER=60/min
