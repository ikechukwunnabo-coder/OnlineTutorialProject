# Ben Digital Solution - production environment template
# Copy to .env.prod, replace every placeholder, and keep it off-host.
# Never commit .env.prod or real credentials.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_NAME=Ben Digital Solution
SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# URL-encode special characters in the password.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://bds:replace-with-a-long-db-password@db:5432/bds
DB_CONNECT_TIMEOUT=5
POSTGRES_DB=bds
POSTGRES_USER=bds
POSTGRES_PASSWORD=replace-with-a-long-db-password

# ---------------------------------------------------------------------------
# Redis (cache, sessions, throttles)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Cookies and transport security
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------------------------
# Email (transactional only)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_RECIPIENT_EMAIL=admin@example.com
EMAIL_TIMEOUT=10
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=86400

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://backend:8000/api/v1
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Content revalidation (Django -> Next.js webhook)
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=replace-with-a-long-random-revalidation-secret
REVALIDATE_URL=http://frontend:3000/api/revalidate

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# ---------------------------------------------------------------------------
# Nginx / TLS
# ---------------------------------------------------------------------------
DOMAIN=example.com
CERTBOT_CONFIG_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot

# ---------------------------------------------------------------------------
# Observability
# Leave SENTRY_DSN empty to disable error tracking.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Throttle defaults (DRF scope rates)
# ---------------------------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=20/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_EMAIL=3/hour
THROTTLE_CONTACT=3/hour
THROTTLE_SEARCH=60/min
THROTTLE_SEARCH_USER=120/min
THROTTLE_SEARCH_SUGGEST=30/min
THROTTLE_SEARCH_SUGGEST_USER=60/min
