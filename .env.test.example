# Ben Digital Solution - test template
# Copy to .env.test. Never commit real credentials.
# With REDIS_URL unset, Django uses LocMemCache.

DJANGO_ENV=test
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=test-only-secret-key-not-used-in-production
DJANGO_ALLOWED_HOSTS=testserver,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SITE_NAME=Ben Digital Solution
SITE_URL=http://localhost:3000

# Leave DATABASE_URL unset for in-memory SQLite.
# Set an absolute path when testing a persistent local database:
# DATABASE_URL=sqlite:///C:/path/to/project/backend/db.sqlite3

# Leave REDIS_URL unset for LocMemCache.
# CI sets this to Redis 8.4.8:
# REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_RECIPIENT_EMAIL=admin@example.com
EMAIL_TIMEOUT=10

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://127.0.0.1:8010/api/v1
NEXT_TELEMETRY_DISABLED=1

REVALIDATE_SECRET=change-me-test-revalidation-secret
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate

MEDIA_ROOT=C:/path/to/project/backend/media
MEDIA_URL=/media/

SENTRY_DSN=
SENTRY_ENVIRONMENT=test
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO

THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=20/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_EMAIL=3/hour
THROTTLE_CONTACT=3/hour
THROTTLE_SEARCH=60/min
THROTTLE_SEARCH_USER=120/min
THROTTLE_SEARCH_SUGGEST=30/min
THROTTLE_SEARCH_SUGGEST_USER=60/min
