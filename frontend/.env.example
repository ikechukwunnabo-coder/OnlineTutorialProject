# Server-side API origin. Never expose credentials here.
# Read at build time by next.config.ts for the /api/v1 rewrites, and at runtime
# by the server session helper. Production builds must set the real internal origin.
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Browser requests use the same-origin Next.js rewrite in development and
# the single-domain reverse proxy in production.
NEXT_PUBLIC_API_BASE_URL=/api/v1

NEXT_PUBLIC_SITE_NAME=Ben Digital Solution
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with Django; generate a long random value in non-local environments.
REVALIDATE_SECRET=
